@prefix : <#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix folio: <https://pkg.semvia.io/semvia/folio/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rml: <http://w3id.org/rml/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix svrl: <https://pkg.semvia.io/semvia/rml/lookup#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
:People rml:logicalSource <people/.well-known/genid/markdown/People-logicalsource> ;
	rml:predicateObjectMap <people/.well-known/genid/markdown/People-battinghand> , <people/.well-known/genid/markdown/People-birthyear> , <people/.well-known/genid/markdown/People-debutdate> , <people/.well-known/genid/markdown/People-familyname> , <people/.well-known/genid/markdown/People-finalgamedate> , <people/.well-known/genid/markdown/People-givenname> , <people/.well-known/genid/markdown/People-throwinghand> ;
	rml:subjectMap <people/.well-known/genid/markdown/People-subjectmap> ;
	a rml:TriplesMap ;
	rdfs:comment "One bball:Person per row, subject-keyed on playerid." ;
	rdfs:label "People" .
<people/.well-known/genid/markdown/People-battinghand-objectmap> rml:reference "bats" ;
	a rml:ObjectMap .
<people/.well-known/genid/markdown/People-battinghand> rml:objectMap <people/.well-known/genid/markdown/People-battinghand-objectmap> ;
	rml:predicate <ontology#battingHand> ;
	a rml:PredicateObjectMap .
<people/.well-known/genid/markdown/People-birthyear-objectmap> rml:datatype xsd:integer ;
	rml:reference "birthyear" ;
	a rml:ObjectMap .
<people/.well-known/genid/markdown/People-birthyear> rml:objectMap <people/.well-known/genid/markdown/People-birthyear-objectmap> ;
	rml:predicate <ontology#birthYear> ;
	a rml:PredicateObjectMap .
<people/.well-known/genid/markdown/People-debutdate-objectmap> rml:datatype xsd:date ;
	rml:reference "debut" ;
	a rml:ObjectMap .
<people/.well-known/genid/markdown/People-debutdate> rml:objectMap <people/.well-known/genid/markdown/People-debutdate-objectmap> ;
	rml:predicate <ontology#debutDate> ;
	a rml:PredicateObjectMap .
<people/.well-known/genid/markdown/People-familyname-objectmap> rml:reference "namelast" ;
	a rml:ObjectMap .
<people/.well-known/genid/markdown/People-familyname> rml:objectMap <people/.well-known/genid/markdown/People-familyname-objectmap> ;
	rml:predicate <ontology#familyName> ;
	a rml:PredicateObjectMap .
<people/.well-known/genid/markdown/People-finalgamedate-objectmap> rml:datatype xsd:date ;
	rml:reference "finalgame" ;
	a rml:ObjectMap .
<people/.well-known/genid/markdown/People-finalgamedate> rml:objectMap <people/.well-known/genid/markdown/People-finalgamedate-objectmap> ;
	rml:predicate <ontology#finalGameDate> ;
	a rml:PredicateObjectMap .
<people/.well-known/genid/markdown/People-givenname-objectmap> rml:reference "namefirst" ;
	a rml:ObjectMap .
<people/.well-known/genid/markdown/People-givenname> rml:objectMap <people/.well-known/genid/markdown/People-givenname-objectmap> ;
	rml:predicate <ontology#givenName> ;
	a rml:PredicateObjectMap .
<people/.well-known/genid/markdown/People-logicalsource> rml:iterator "SELECT playerid, namefirst, namelast, bats, throws, debut, finalgame, CAST(birthyear AS integer) AS birthyear FROM public.people" ;
	rml:referenceFormulation rml:SQL2008Query ;
	rml:source <connection#semvia-test-data> ;
	a rml:LogicalSource .
<people/.well-known/genid/markdown/People-subjectmap> rml:class <ontology#Person> ;
	rml:template "https://github.com/SemviaIO/lahman-baseball/person/{playerid}" ;
	a rml:SubjectMap .
<people/.well-known/genid/markdown/People-throwinghand-objectmap> rml:reference "throws" ;
	a rml:ObjectMap .
<people/.well-known/genid/markdown/People-throwinghand> rml:objectMap <people/.well-known/genid/markdown/People-throwinghand-objectmap> ;
	rml:predicate <ontology#throwingHand> ;
	a rml:PredicateObjectMap .
<> dct:title "People"@en ;
	a <https://pkg.semvia.io/semvia/core/document#Document> , folio:rml-mapping-schema\#RmlMapping ;
	folio:mapping\#mappedBy folio:rml-mapping-map\#RmlMappingMap .
