<stints/.well-known/genid/markdown/PitchingStints-logicalsource> rml:iterator "SELECT playerid, yearid, stint, teamid, lgid, CAST(w AS integer) AS wins, CAST(l AS integer) AS losses, CAST(sv AS integer) AS saves, CAST(era AS numeric) AS earnedrunaverage FROM public.pitching" ;
