<stints/.well-known/genid/markdown/BattingStints-logicalsource> rml:iterator "SELECT playerid, yearid, stint, teamid, lgid, CAST(stint AS integer) AS ordinal, CAST(g AS integer) AS games, CAST(ab AS integer) AS atbats, CAST(h AS integer) AS hits, CAST(c_2b AS integer) AS doubles, CAST(c_3b AS integer) AS triples, CAST(hr AS integer) AS homeruns, CAST(rbi AS integer) AS runsbattedin, CAST(sb AS integer) AS stolenbases, CAST(bb AS integer) AS walks, CAST(so AS integer) AS strikeouts FROM public.batting" ;
	rml:referenceFormulation rml:SQL2008Query ;
	rml:source <connection#semvia-test-data> ;
	a rml:LogicalSource .
<stints/.well-known/genid/markdown/BattingStints-player-objectmap-joincondition> rml:child "playerid" ;
	rml:parent "playerid" ;
	a rml:Join .
<stints/.well-known/genid/markdown/BattingStints-player-objectmap> rml:joinCondition <stints/.well-known/genid/markdown/BattingStints-player-objectmap-joincondition> ;
	rml:parentTriplesMap <people#People> ;
	a rml:RefObjectMap .
<stints/.well-known/genid/markdown/BattingStints-player> rml:objectMap <stints/.well-known/genid/markdown/BattingStints-player-objectmap> ;
