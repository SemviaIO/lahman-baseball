	rml:predicate <ontology#gamesAtPosition> ;
	a rml:PredicateObjectMap .
<stints/.well-known/genid/markdown/PositionAppearances-logicalsource> rml:iterator "SELECT playerid, yearid, stint, teamid, lgid, pos, gamesatposition FROM (SELECT playerid, yearid, '1' AS stint, teamid, lgid, 'P' AS pos, CAST(g_p AS integer) AS gamesatposition FROM public.appearances UNION ALL SELECT playerid, yearid, '1', teamid, lgid, 'C', CAST(g_c AS integer) FROM public.appearances UNION ALL SELECT playerid, yearid, '1', teamid, lgid, '1B', CAST(g_1b AS integer) FROM public.appearances UNION ALL SELECT playerid, yearid, '1', teamid, lgid, '2B', CAST(g_2b AS integer) FROM public.appearances UNION ALL SELECT playerid, yearid, '1', teamid, lgid, '3B', CAST(g_3b AS integer) FROM public.appearances UNION ALL SELECT playerid, yearid, '1', teamid, lgid, 'SS', CAST(g_ss AS integer) FROM public.appearances UNION ALL SELECT playerid, yearid, '1', teamid, lgid, 'LF', CAST(g_lf AS integer) FROM public.appearances UNION ALL SELECT playerid, yearid, '1', teamid, lgid, 'CF', CAST(g_cf AS integer) FROM public.appearances UNION ALL SELECT playerid, yearid, '1', teamid, lgid, 'RF', CAST(g_rf AS integer) FROM public.appearances UNION ALL SELECT playerid, yearid, '1', teamid, lgid, 'OF', CAST(g_of AS integer) FROM public.appearances UNION ALL SELECT playerid, yearid, '1', teamid, lgid, 'DH', CAST(g_dh AS integer) FROM public.appearances UNION ALL SELECT playerid, yearid, '1', teamid, lgid, 'PH', CAST(g_ph AS integer) FROM public.appearances UNION ALL SELECT playerid, yearid, '1', teamid, lgid, 'PR', CAST(g_pr AS integer) FROM public.appearances) positions WHERE gamesatposition > 0" ;
	rml:referenceFormulation rml:SQL2008Query ;
	rml:source <connection#semvia-test-data> ;
	a rml:LogicalSource .
<stints/.well-known/genid/markdown/PositionAppearances-player-objectmap-joincondition> rml:child "playerid" ;
	rml:parent "playerid" ;
	a rml:Join .
<stints/.well-known/genid/markdown/PositionAppearances-player-objectmap> rml:joinCondition <stints/.well-known/genid/markdown/PositionAppearances-player-objectmap-joincondition> ;
	rml:parentTriplesMap <people#People> ;
	a rml:RefObjectMap .
