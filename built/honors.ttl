	rml:parentTriplesMap <people#People> ;
	a rml:RefObjectMap .
_:c14n20 rml:objectMap _:c14n32 ;
	rml:predicate <ontology#player> ;
	a rml:PredicateObjectMap .
_:c14n5 rml:datatype xsd:integer ;
	rml:reference "seasonyear" ;
	a rml:ObjectMap .
_:c14n25 rml:objectMap _:c14n5 ;
	rml:predicate <ontology#seasonYear> ;
	a rml:PredicateObjectMap .
_:c14n9 rml:reference "tie" ;
	a rml:ObjectMap .
_:c14n12 rml:objectMap _:c14n9 ;
	rml:predicate <ontology#sharedHonor> ;
	a rml:PredicateObjectMap .
_:c14n18 rml:class <ontology#AwardHonor> ;
	rml:template "https://pkg.semvia.io/semvia/lahman-baseball/award-honor/{playerid}-{awardkey}-{yearid}-{lgid}-{citationkey}" ;
	a rml:SubjectMap .
