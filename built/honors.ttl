_:c14n3 rml:iterator "SELECT playerid, yearid, votedby, inducted, category, trim(both '-' from regexp_replace(lower(votedby), '[^a-z0-9]+', '-', 'g')) AS votingbodykey, CAST(yearid AS integer) AS ballotyear, CAST(ballots AS integer) AS ballotscast, CAST(votes AS integer) AS votesreceived, CAST(needed AS integer) AS votesneeded FROM public.halloffame" ;
	rml:referenceFormulation rml:SQL2008Query ;
	rml:source <connection#semvia-test-data> ;
