@prefix : <#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix folio: <https://pkg.semvia.io/semvia/folio/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rml: <http://w3id.org/rml/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix svrl: <https://pkg.semvia.io/semvia/rml/lookup#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
:AwardHonors rml:logicalSource <honors/.well-known/genid/markdown/AwardHonors-logicalsource> ;
	rml:predicateObjectMap <honors/.well-known/genid/markdown/AwardHonors-award> , <honors/.well-known/genid/markdown/AwardHonors-citation> , <honors/.well-known/genid/markdown/AwardHonors-league> , <honors/.well-known/genid/markdown/AwardHonors-player> , <honors/.well-known/genid/markdown/AwardHonors-seasonyear> , <honors/.well-known/genid/markdown/AwardHonors-sharedhonor> ;
	rml:subjectMap <honors/.well-known/genid/markdown/AwardHonors-subjectmap> ;
	a rml:TriplesMap ;
	rdfs:comment "One bball:AwardHonor per row of public.awardsplayers — 12,667 rows.\nThe citation is part of the key, not a decoration on it: 492 groups of rows share\nperson, award, year and league exactly, separated only by the free-text note — a\nPlayer of the Week won twice in one summer. A subject template that omitted it\nwould fuse those conferrals into one resource and lose the count.\nThe note is also NULL on 12,008 rows, and a NULL spliced into a template is fatal\nrather than merely awkward: the engine's row-validity filter drops the whole row,\nbecause SQL concat swallows a NULL and would otherwise mint an IRI from a\npartial tuple. COALESCE to the empty string inside the slug expression is what\nkeeps those 12,008 conferrals in the graph; their IRIs simply end in a trailing\nhyphen." ;
	rdfs:label "AwardHonors" .
:HallOfFameBallots rml:logicalSource <honors/.well-known/genid/markdown/HallOfFameBallots-logicalsource> ;
	rml:predicateObjectMap <honors/.well-known/genid/markdown/HallOfFameBallots-ballotscast> , <honors/.well-known/genid/markdown/HallOfFameBallots-ballotyear> , <honors/.well-known/genid/markdown/HallOfFameBallots-inducted> , <honors/.well-known/genid/markdown/HallOfFameBallots-inducteecategory> , <honors/.well-known/genid/markdown/HallOfFameBallots-player> , <honors/.well-known/genid/markdown/HallOfFameBallots-votesneeded> , <honors/.well-known/genid/markdown/HallOfFameBallots-votesreceived> , <honors/.well-known/genid/markdown/HallOfFameBallots-votingbody> ;
	rml:subjectMap <honors/.well-known/genid/markdown/HallOfFameBallots-subjectmap> ;
	a rml:TriplesMap ;
	rdfs:comment "One bball:HallOfFameBallot per row of public.halloffame — 6,426 rows.\nNote the key: person, year, and voting body. Person and year alone are not\nenough — 146 rows share a (playerid, yearid) pair, a player considered by the\nwriters and by a committee in the same year." ;
	rdfs:label "HallOfFameBallots" .
<honors/.well-known/genid/markdown/AwardHonors-award-objectmap> rml:reference "awardid" ;
	a rml:ObjectMap .
<honors/.well-known/genid/markdown/AwardHonors-award> rml:objectMap <honors/.well-known/genid/markdown/AwardHonors-award-objectmap> ;
	rml:predicate <ontology#award> ;
	a rml:PredicateObjectMap .
<honors/.well-known/genid/markdown/AwardHonors-citation-objectmap> rml:reference "notes" ;
	a rml:ObjectMap .
<honors/.well-known/genid/markdown/AwardHonors-citation> rml:objectMap <honors/.well-known/genid/markdown/AwardHonors-citation-objectmap> ;
	rml:predicate <ontology#citation> ;
	a rml:PredicateObjectMap .
<honors/.well-known/genid/markdown/AwardHonors-league-objectmap> rml:reference "lgid" ;
	a rml:ObjectMap .
<honors/.well-known/genid/markdown/AwardHonors-league> rml:objectMap <honors/.well-known/genid/markdown/AwardHonors-league-objectmap> ;
	rml:predicate <ontology#league> ;
	a rml:PredicateObjectMap .
<honors/.well-known/genid/markdown/AwardHonors-logicalsource> rml:iterator "SELECT playerid, yearid, lgid, awardid, tie, notes, trim(both '-' from regexp_replace(lower(awardid), '[^a-z0-9]+', '-', 'g')) AS awardkey, trim(both '-' from regexp_replace(lower(coalesce(notes, '')), '[^a-z0-9]+', '-', 'g')) AS citationkey, CAST(yearid AS integer) AS seasonyear FROM public.awardsplayers" ;
	rml:referenceFormulation rml:SQL2008Query ;
	rml:source <connection#semvia-test-data> ;
	a rml:LogicalSource .
<honors/.well-known/genid/markdown/AwardHonors-player-objectmap-joincondition> rml:child "playerid" ;
	rml:parent "playerid" ;
	a rml:Join .
<honors/.well-known/genid/markdown/AwardHonors-player-objectmap> rml:joinCondition <honors/.well-known/genid/markdown/AwardHonors-player-objectmap-joincondition> ;
	rml:parentTriplesMap <people#People> ;
	a rml:RefObjectMap .
<honors/.well-known/genid/markdown/AwardHonors-player> rml:objectMap <honors/.well-known/genid/markdown/AwardHonors-player-objectmap> ;
	rml:predicate <ontology#player> ;
	a rml:PredicateObjectMap .
<honors/.well-known/genid/markdown/AwardHonors-seasonyear-objectmap> rml:datatype xsd:integer ;
	rml:reference "seasonyear" ;
	a rml:ObjectMap .
<honors/.well-known/genid/markdown/AwardHonors-seasonyear> rml:objectMap <honors/.well-known/genid/markdown/AwardHonors-seasonyear-objectmap> ;
	rml:predicate <ontology#seasonYear> ;
	a rml:PredicateObjectMap .
<honors/.well-known/genid/markdown/AwardHonors-sharedhonor-objectmap> rml:reference "tie" ;
	a rml:ObjectMap .
<honors/.well-known/genid/markdown/AwardHonors-sharedhonor> rml:objectMap <honors/.well-known/genid/markdown/AwardHonors-sharedhonor-objectmap> ;
	rml:predicate <ontology#sharedHonor> ;
	a rml:PredicateObjectMap .
<honors/.well-known/genid/markdown/AwardHonors-subjectmap> rml:class <ontology#AwardHonor> ;
	rml:template "https://github.com/SemviaIO/lahman-baseball/award-honor/{playerid}-{awardkey}-{yearid}-{lgid}-{citationkey}" ;
	a rml:SubjectMap .
<honors/.well-known/genid/markdown/HallOfFameBallots-ballotscast-objectmap> rml:datatype xsd:integer ;
	rml:reference "ballotscast" ;
	a rml:ObjectMap .
<honors/.well-known/genid/markdown/HallOfFameBallots-ballotscast> rml:objectMap <honors/.well-known/genid/markdown/HallOfFameBallots-ballotscast-objectmap> ;
	rml:predicate <ontology#ballotsCast> ;
	a rml:PredicateObjectMap .
<honors/.well-known/genid/markdown/HallOfFameBallots-ballotyear-objectmap> rml:datatype xsd:integer ;
	rml:reference "ballotyear" ;
	a rml:ObjectMap .
<honors/.well-known/genid/markdown/HallOfFameBallots-ballotyear> rml:objectMap <honors/.well-known/genid/markdown/HallOfFameBallots-ballotyear-objectmap> ;
	rml:predicate <ontology#ballotYear> ;
	a rml:PredicateObjectMap .
<honors/.well-known/genid/markdown/HallOfFameBallots-inducted-objectmap> rml:reference "inducted" ;
	a rml:ObjectMap .
<honors/.well-known/genid/markdown/HallOfFameBallots-inducted> rml:objectMap <honors/.well-known/genid/markdown/HallOfFameBallots-inducted-objectmap> ;
	rml:predicate <ontology#inducted> ;
	a rml:PredicateObjectMap .
<honors/.well-known/genid/markdown/HallOfFameBallots-inducteecategory-objectmap> rml:reference "category" ;
	a rml:ObjectMap .
<honors/.well-known/genid/markdown/HallOfFameBallots-inducteecategory> rml:objectMap <honors/.well-known/genid/markdown/HallOfFameBallots-inducteecategory-objectmap> ;
	rml:predicate <ontology#inducteeCategory> ;
	a rml:PredicateObjectMap .
<honors/.well-known/genid/markdown/HallOfFameBallots-logicalsource> rml:iterator "SELECT playerid, yearid, votedby, inducted, category, trim(both '-' from regexp_replace(lower(votedby), '[^a-z0-9]+', '-', 'g')) AS votingbodykey, CAST(yearid AS integer) AS ballotyear, CAST(ballots AS integer) AS ballotscast, CAST(votes AS integer) AS votesreceived, CAST(needed AS integer) AS votesneeded FROM public.halloffame" ;
	rml:referenceFormulation rml:SQL2008Query ;
	rml:source <connection#semvia-test-data> ;
	a rml:LogicalSource .
<honors/.well-known/genid/markdown/HallOfFameBallots-player-objectmap-joincondition> rml:child "playerid" ;
	rml:parent "playerid" ;
	a rml:Join .
<honors/.well-known/genid/markdown/HallOfFameBallots-player-objectmap> rml:joinCondition <honors/.well-known/genid/markdown/HallOfFameBallots-player-objectmap-joincondition> ;
	rml:parentTriplesMap <people#People> ;
	a rml:RefObjectMap .
<honors/.well-known/genid/markdown/HallOfFameBallots-player> rml:objectMap <honors/.well-known/genid/markdown/HallOfFameBallots-player-objectmap> ;
	rml:predicate <ontology#player> ;
	a rml:PredicateObjectMap .
<honors/.well-known/genid/markdown/HallOfFameBallots-subjectmap> rml:class <ontology#HallOfFameBallot> ;
	rml:template "https://github.com/SemviaIO/lahman-baseball/hall-of-fame-ballot/{playerid}-{yearid}-{votingbodykey}" ;
	a rml:SubjectMap .
<honors/.well-known/genid/markdown/HallOfFameBallots-votesneeded-objectmap> rml:datatype xsd:integer ;
	rml:reference "votesneeded" ;
	a rml:ObjectMap .
<honors/.well-known/genid/markdown/HallOfFameBallots-votesneeded> rml:objectMap <honors/.well-known/genid/markdown/HallOfFameBallots-votesneeded-objectmap> ;
	rml:predicate <ontology#votesNeeded> ;
	a rml:PredicateObjectMap .
<honors/.well-known/genid/markdown/HallOfFameBallots-votesreceived-objectmap> rml:datatype xsd:integer ;
	rml:reference "votesreceived" ;
	a rml:ObjectMap .
<honors/.well-known/genid/markdown/HallOfFameBallots-votesreceived> rml:objectMap <honors/.well-known/genid/markdown/HallOfFameBallots-votesreceived-objectmap> ;
	rml:predicate <ontology#votesReceived> ;
	a rml:PredicateObjectMap .
<honors/.well-known/genid/markdown/HallOfFameBallots-votingbody-objectmap> rml:reference "votedby" ;
	a rml:ObjectMap .
<honors/.well-known/genid/markdown/HallOfFameBallots-votingbody> rml:objectMap <honors/.well-known/genid/markdown/HallOfFameBallots-votingbody-objectmap> ;
	rml:predicate <ontology#votingBody> ;
	a rml:PredicateObjectMap .
<> dct:title "Honors"@en ;
	a <https://pkg.semvia.io/semvia/core/document#Document> , folio:rml-mapping-schema\#RmlMapping ;
	folio:mapping\#mappedBy folio:rml-mapping-map\#RmlMappingMap .
