	a rml:PredicateObjectMap .
_:c14n8 rml:reference "country" ;
	a rml:ObjectMap .
_:c14n15 rml:objectMap _:c14n8 ;
	rml:predicate <ontology#country> ;
	a rml:PredicateObjectMap .
_:c14n0 rml:iterator "public.schools" ;
	rml:referenceFormulation rml:SQL2008Table ;
