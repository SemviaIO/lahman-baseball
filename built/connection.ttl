@prefix conn: <#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix svdb: <https://pkg.semvia.io/semvia/rml/connection#> .
@prefix svds: <https://pkg.semvia.io/semvia/core/dataset#> .
@prefix svs: <https://pkg.semvia.io/semvia/core/meta-schema#> .
<> a svs:Schema ;
	dct:title "Lahman Database Connection"@en ;
	dct:description "The svdb:PostgresConnection descriptor this package's RML logical sources resolve their relations against. Carries host, port, database, user and SSL mode; carries no credential."@en ;
	svds:imports <https://pkg.semvia.io/semvia/core/meta-schema> , <https://pkg.semvia.io/semvia/rml/connection> .
_:c14n0 a sh:PrefixDeclaration ;
	sh:prefix "conn" ;
	sh:namespace conn: .
<> sh:declare _:c14n0 .
conn:semvia-test-data a svdb:PostgresConnection ;
	rdfs:label "semvia-test-data (lahman)"@en ;
	rdfs:comment "The Lahman baseball database in the semvia-test-data Neon project — the same endpoint the gleif package names, a different database on it. `lahman` is the DATABASE name and `public` is the schema holding the 27 relations, so the mappings iterate `public.people`, `public.batting` and the rest; `lahman.people` would name nothing, and a relation reference resolving to nothing registers with an empty Arrow schema, which the federation engine refuses."@en ;
	svdb:host "ep-small-block-aymhbzd3.c-5.us-east-2.aws.neon.tech" ;
	svdb:port 5432 ;
	svdb:database "lahman" ;
	svdb:user "reader" ;
	svdb:sslMode "verify-full" .
