	a rml:PredicateObjectMap .
<franchises-and-seasons/.well-known/genid/markdown/Franchises-subjectmap> rml:class <ontology#Franchise> ;
	rml:template "https://github.com/SemviaIO/lahman-baseball/franchise/{franchid}" ;
	a rml:SubjectMap .
<franchises-and-seasons/.well-known/genid/markdown/ManagerStints-games-objectmap> rml:datatype xsd:integer ;
	rml:reference "games" ;
