<franchises-and-seasons/.well-known/genid/markdown/ManagerStints-stintordinal-objectmap> rml:datatype xsd:integer ;
	rml:reference "ordinal" ;
	a rml:ObjectMap .
<franchises-and-seasons/.well-known/genid/markdown/ManagerStints-stintordinal> rml:objectMap <franchises-and-seasons/.well-known/genid/markdown/ManagerStints-stintordinal-objectmap> ;
