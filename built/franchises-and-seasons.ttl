<franchises-and-seasons/.well-known/genid/markdown/ManagerStints-games> rml:objectMap <franchises-and-seasons/.well-known/genid/markdown/ManagerStints-games-objectmap> ;
	rml:predicate <ontology#games> ;
	a rml:PredicateObjectMap .
<franchises-and-seasons/.well-known/genid/markdown/ManagerStints-logicalsource> rml:iterator "SELECT playerid, yearid, teamid, lgid, inseason, CAST(inseason AS integer) AS ordinal, CAST(g AS integer) AS games, CAST(w AS integer) AS wins, CAST(l AS integer) AS losses, CAST(rank AS integer) AS standingsrank FROM public.managers" ;
	rml:referenceFormulation rml:SQL2008Query ;
