@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
:Franchises rml:logicalSource <franchises-and-seasons/.well-known/genid/markdown/Franchises-logicalsource> ;
	rml:predicateObjectMap <franchises-and-seasons/.well-known/genid/markdown/Franchises-active> , <franchises-and-seasons/.well-known/genid/markdown/Franchises-name> ;
	rml:subjectMap <franchises-and-seasons/.well-known/genid/markdown/Franchises-subjectmap> ;
	a rml:TriplesMap ;
	rdfs:comment "One bball:Franchise per row of public.teamsfranchises — 203 rows, one per\ncontinuing organization. This is the one relation in the package that needs no\ncast, no coalesce and no query source: three text columns, all of them text-typed\nin the conceptual layer too, so a plain table source is honest." ;
	rdfs:label "Franchises" .
:ManagerStints rml:logicalSource <franchises-and-seasons/.well-known/genid/markdown/ManagerStints-logicalsource> ;
	rml:predicateObjectMap <franchises-and-seasons/.well-known/genid/markdown/ManagerStints-games> , <franchises-and-seasons/.well-known/genid/markdown/ManagerStints-losses> , <franchises-and-seasons/.well-known/genid/markdown/ManagerStints-player> , <franchises-and-seasons/.well-known/genid/markdown/ManagerStints-standingsrank> , <franchises-and-seasons/.well-known/genid/markdown/ManagerStints-stintordinal> , <franchises-and-seasons/.well-known/genid/markdown/ManagerStints-teamseason> , <franchises-and-seasons/.well-known/genid/markdown/ManagerStints-wins> ;
	rml:subjectMap <franchises-and-seasons/.well-known/genid/markdown/ManagerStints-subjectmap> ;
	a rml:TriplesMap ;
	rdfs:comment "One bball:ManagerStint per row of public.managers — 4,410 rows, injective on\n(playerid, yearid, teamid, inseason).\ninseason appears twice for the same reason yearid does in TeamSeasons: as raw\ntext it splices the subject IRI, as ordinal it is the integer a query compares." ;
	rdfs:label "ManagerStints" .
:TeamSeasons rml:logicalSource <franchises-and-seasons/.well-known/genid/markdown/TeamSeasons-logicalsource> ;
	rml:predicateObjectMap <franchises-and-seasons/.well-known/genid/markdown/TeamSeasons-franchise> , <franchises-and-seasons/.well-known/genid/markdown/TeamSeasons-league> , <franchises-and-seasons/.well-known/genid/markdown/TeamSeasons-losses> , <franchises-and-seasons/.well-known/genid/markdown/TeamSeasons-name> , <franchises-and-seasons/.well-known/genid/markdown/TeamSeasons-seasonyear> , <franchises-and-seasons/.well-known/genid/markdown/TeamSeasons-standingsrank> , <franchises-and-seasons/.well-known/genid/markdown/TeamSeasons-wins> , <franchises-and-seasons/.well-known/genid/markdown/TeamSeasons-wonworldseries> ;
	rml:subjectMap <franchises-and-seasons/.well-known/genid/markdown/TeamSeasons-subjectmap> ;
	a rml:TriplesMap ;
	rdfs:comment "One bball:TeamSeason per row of public.teams — 3,614 rows, injective on the\nthree-column subject template.\nThe SELECT keeps yearid, teamid, lgid and franchid in their raw text form\nbecause they are template splices and join columns, and adds cast copies under\nconceptual names for the columns the corpus computes over. seasonyear is the\ncast twin of yearid: the template needs the text, a ?ts bball:seasonYear 1998\nfilter needs the integer, and one column cannot be both.\nrank reads as a bare column in the SELECT. It is also the name of a Postgres\nwindow function, but a bare rank in a value expression is a column reference —\nonly rank() with the parentheses is the function — so no quoting is needed and\nnone is used." ;
	rdfs:label "TeamSeasons" .
<franchises-and-seasons/.well-known/genid/markdown/Franchises-active-objectmap> rml:reference "active" ;
	a rml:ObjectMap .
<franchises-and-seasons/.well-known/genid/markdown/Franchises-active> rml:objectMap <franchises-and-seasons/.well-known/genid/markdown/Franchises-active-objectmap> ;
	rml:predicate <ontology#active> ;
	a rml:PredicateObjectMap .
<franchises-and-seasons/.well-known/genid/markdown/Franchises-logicalsource> rml:iterator "public.teamsfranchises" ;
	rml:referenceFormulation rml:SQL2008Table ;
	rml:source <connection#semvia-test-data> ;
	a rml:LogicalSource .
<franchises-and-seasons/.well-known/genid/markdown/Franchises-name-objectmap> rml:reference "franchname" ;
	a rml:ObjectMap .
