	rml:parentTriplesMap :TeamSeasons ;
	a rml:RefObjectMap .
<franchises-and-seasons/.well-known/genid/markdown/ManagerStints-teamseason> rml:objectMap <franchises-and-seasons/.well-known/genid/markdown/ManagerStints-teamseason-objectmap> ;
	rml:predicate <ontology#teamSeason> ;
