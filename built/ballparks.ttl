_:c14n13 rml:iterator "SELECT yearkey, teamkey, leaguekey, parkkey, spanfirst, spanlast, CAST(yearkey AS integer) AS seasonyear, CAST(games AS integer) AS gameshosted, CAST(attendance AS integer) AS seasonattendance FROM public.homegames" ;
