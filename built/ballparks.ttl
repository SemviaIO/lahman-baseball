@prefix : <#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix folio: <https://pkg.semvia.io/semvia/folio/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rml: <http://w3id.org/rml/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix svrl: <https://pkg.semvia.io/semvia/rml/lookup#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
:BallparkTenures rml:logicalSource <ballparks/.well-known/genid/markdown/BallparkTenures-logicalsource> ;
	rml:predicateObjectMap <ballparks/.well-known/genid/markdown/BallparkTenures-ballpark> , <ballparks/.well-known/genid/markdown/BallparkTenures-firsthomegamedate> , <ballparks/.well-known/genid/markdown/BallparkTenures-gameshosted> , <ballparks/.well-known/genid/markdown/BallparkTenures-lasthomegamedate> , <ballparks/.well-known/genid/markdown/BallparkTenures-seasonattendance> , <ballparks/.well-known/genid/markdown/BallparkTenures-seasonyear> , <ballparks/.well-known/genid/markdown/BallparkTenures-teamseason> ;
	rml:subjectMap <ballparks/.well-known/genid/markdown/BallparkTenures-subjectmap> ;
	a rml:TriplesMap ;
	rdfs:comment "One bball:BallparkTenure per row of public.homegames — 3,303 rows, injective\non year, team and park.\nThe register spells this relation's key columns yearkey, teamkey and\nleaguekey where every other relation spells them yearid, teamid and lgid.\nThe mapping does not rename them — a reference must name the column the source\ndelivers — but the join conditions below are where that inconsistency stops being\nthe consumer's problem, because bball:teamSeason reconciles the two spellings\nonce and every query afterwards sees one edge." ;
	rdfs:label "BallparkTenures" .
:Ballparks rml:logicalSource <ballparks/.well-known/genid/markdown/Ballparks-logicalsource> ;
	rml:predicateObjectMap <ballparks/.well-known/genid/markdown/Ballparks-city> , <ballparks/.well-known/genid/markdown/Ballparks-country> , <ballparks/.well-known/genid/markdown/Ballparks-name> , <ballparks/.well-known/genid/markdown/Ballparks-state> ;
	rml:subjectMap <ballparks/.well-known/genid/markdown/Ballparks-subjectmap> ;
	a rml:TriplesMap ;
	rdfs:comment "One bball:Ballpark per row of public.parks — 345 rows, keyed on parkkey,\nwhich is distinct and non-NULL throughout. The relation also carries id and\nparkalias; neither is mapped. id is a surrogate with no meaning outside the\ndump, and parkalias is a semicolon-joined list of former names that would need\nsplitting before it could be more than a string." ;
	rdfs:label "Ballparks" .
<ballparks/.well-known/genid/markdown/BallparkTenures-ballpark-objectmap-joincondition> rml:child "parkkey" ;
	rml:parent "parkkey" ;
	a rml:Join .
<ballparks/.well-known/genid/markdown/BallparkTenures-ballpark-objectmap> rml:joinCondition <ballparks/.well-known/genid/markdown/BallparkTenures-ballpark-objectmap-joincondition> ;
	rml:parentTriplesMap :Ballparks ;
	a rml:RefObjectMap .
<ballparks/.well-known/genid/markdown/BallparkTenures-ballpark> rml:objectMap <ballparks/.well-known/genid/markdown/BallparkTenures-ballpark-objectmap> ;
	rml:predicate <ontology#ballpark> ;
	a rml:PredicateObjectMap .
<ballparks/.well-known/genid/markdown/BallparkTenures-firsthomegamedate-objectmap> rml:datatype xsd:date ;
	rml:reference "spanfirst" ;
	a rml:ObjectMap .
<ballparks/.well-known/genid/markdown/BallparkTenures-firsthomegamedate> rml:objectMap <ballparks/.well-known/genid/markdown/BallparkTenures-firsthomegamedate-objectmap> ;
	rml:predicate <ontology#firstHomeGameDate> ;
	a rml:PredicateObjectMap .
<ballparks/.well-known/genid/markdown/BallparkTenures-gameshosted-objectmap> rml:datatype xsd:integer ;
	rml:reference "gameshosted" ;
	a rml:ObjectMap .
<ballparks/.well-known/genid/markdown/BallparkTenures-gameshosted> rml:objectMap <ballparks/.well-known/genid/markdown/BallparkTenures-gameshosted-objectmap> ;
	rml:predicate <ontology#gamesHosted> ;
	a rml:PredicateObjectMap .
<ballparks/.well-known/genid/markdown/BallparkTenures-lasthomegamedate-objectmap> rml:datatype xsd:date ;
	rml:reference "spanlast" ;
	a rml:ObjectMap .
<ballparks/.well-known/genid/markdown/BallparkTenures-lasthomegamedate> rml:objectMap <ballparks/.well-known/genid/markdown/BallparkTenures-lasthomegamedate-objectmap> ;
	rml:predicate <ontology#lastHomeGameDate> ;
	a rml:PredicateObjectMap .
<ballparks/.well-known/genid/markdown/BallparkTenures-logicalsource> rml:iterator "SELECT yearkey, teamkey, leaguekey, parkkey, spanfirst, spanlast, CAST(yearkey AS integer) AS seasonyear, CAST(games AS integer) AS gameshosted, CAST(attendance AS integer) AS seasonattendance FROM public.homegames" ;
	rml:referenceFormulation rml:SQL2008Query ;
	rml:source <connection#semvia-test-data> ;
	a rml:LogicalSource .
<ballparks/.well-known/genid/markdown/BallparkTenures-seasonattendance-objectmap> rml:datatype xsd:integer ;
	rml:reference "seasonattendance" ;
	a rml:ObjectMap .
<ballparks/.well-known/genid/markdown/BallparkTenures-seasonattendance> rml:objectMap <ballparks/.well-known/genid/markdown/BallparkTenures-seasonattendance-objectmap> ;
	rml:predicate <ontology#seasonAttendance> ;
	a rml:PredicateObjectMap .
<ballparks/.well-known/genid/markdown/BallparkTenures-seasonyear-objectmap> rml:datatype xsd:integer ;
	rml:reference "seasonyear" ;
	a rml:ObjectMap .
<ballparks/.well-known/genid/markdown/BallparkTenures-seasonyear> rml:objectMap <ballparks/.well-known/genid/markdown/BallparkTenures-seasonyear-objectmap> ;
	rml:predicate <ontology#seasonYear> ;
	a rml:PredicateObjectMap .
<ballparks/.well-known/genid/markdown/BallparkTenures-subjectmap> rml:class <ontology#BallparkTenure> ;
	rml:template "https://github.com/SemviaIO/lahman-baseball/ballpark-tenure/{yearkey}-{teamkey}-{parkkey}" ;
	a rml:SubjectMap .
<ballparks/.well-known/genid/markdown/BallparkTenures-teamseason-objectmap-joincondition> rml:child "teamkey" ;
	rml:parent "teamid" ;
	a rml:Join .
<ballparks/.well-known/genid/markdown/BallparkTenures-teamseason-objectmap-joincondition~1> rml:child "yearkey" ;
	rml:parent "yearid" ;
	a rml:Join .
<ballparks/.well-known/genid/markdown/BallparkTenures-teamseason-objectmap-joincondition~2> rml:child "leaguekey" ;
	rml:parent "lgid" ;
	a rml:Join .
<ballparks/.well-known/genid/markdown/BallparkTenures-teamseason-objectmap> rml:joinCondition <ballparks/.well-known/genid/markdown/BallparkTenures-teamseason-objectmap-joincondition> , <ballparks/.well-known/genid/markdown/BallparkTenures-teamseason-objectmap-joincondition~1> , <ballparks/.well-known/genid/markdown/BallparkTenures-teamseason-objectmap-joincondition~2> ;
	rml:parentTriplesMap <franchises-and-seasons#TeamSeasons> ;
	a rml:RefObjectMap .
<ballparks/.well-known/genid/markdown/BallparkTenures-teamseason> rml:objectMap <ballparks/.well-known/genid/markdown/BallparkTenures-teamseason-objectmap> ;
	rml:predicate <ontology#teamSeason> ;
	a rml:PredicateObjectMap .
<ballparks/.well-known/genid/markdown/Ballparks-city-objectmap> rml:reference "city" ;
	a rml:ObjectMap .
<ballparks/.well-known/genid/markdown/Ballparks-city> rml:objectMap <ballparks/.well-known/genid/markdown/Ballparks-city-objectmap> ;
	rml:predicate <ontology#city> ;
	a rml:PredicateObjectMap .
<ballparks/.well-known/genid/markdown/Ballparks-country-objectmap> rml:reference "country" ;
	a rml:ObjectMap .
<ballparks/.well-known/genid/markdown/Ballparks-country> rml:objectMap <ballparks/.well-known/genid/markdown/Ballparks-country-objectmap> ;
	rml:predicate <ontology#country> ;
	a rml:PredicateObjectMap .
<ballparks/.well-known/genid/markdown/Ballparks-logicalsource> rml:iterator "public.parks" ;
	rml:referenceFormulation rml:SQL2008Table ;
	rml:source <connection#semvia-test-data> ;
	a rml:LogicalSource .
<ballparks/.well-known/genid/markdown/Ballparks-name-objectmap> rml:reference "parkname" ;
	a rml:ObjectMap .
<ballparks/.well-known/genid/markdown/Ballparks-name> rml:objectMap <ballparks/.well-known/genid/markdown/Ballparks-name-objectmap> ;
	rml:predicate <ontology#name> ;
	a rml:PredicateObjectMap .
<ballparks/.well-known/genid/markdown/Ballparks-state-objectmap> rml:reference "state" ;
	a rml:ObjectMap .
<ballparks/.well-known/genid/markdown/Ballparks-state> rml:objectMap <ballparks/.well-known/genid/markdown/Ballparks-state-objectmap> ;
	rml:predicate <ontology#state> ;
	a rml:PredicateObjectMap .
<ballparks/.well-known/genid/markdown/Ballparks-subjectmap> rml:class <ontology#Ballpark> ;
	rml:template "https://github.com/SemviaIO/lahman-baseball/park/{parkkey}" ;
	a rml:SubjectMap .
<> dct:title "Ballparks"@en ;
	a <https://pkg.semvia.io/semvia/core/document#Document> , folio:rml-mapping-schema\#RmlMapping ;
	folio:mapping\#mappedBy folio:rml-mapping-map\#RmlMappingMap .
